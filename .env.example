# ── Server only (Vercel → Project → Settings → Environment Variables) ─────────
# Never prefix these with VITE_ — VITE_ values are bundled into the browser.

# Neon pooled connection (host contains "-pooler"), used by the API at runtime
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Neon direct connection (same host without "-pooler"), used by `npm run db:migrate`
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require
# Random 32+ byte secret that signs portal sessions: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Portal sign-in, checked on the server
ADMIN_ID=
ADMIN_PASSWORD=
STAFF_ID=
STAFF_PASSWORD=

# ── One-time Supabase → Neon data copy (npm run db:import-supabase), local only ─
SUPABASE_DB_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── Browser (public) ───────────────────────────────────────────────────────────
# Optional: customer sign-in page (/login) via Supabase Auth. Leave blank to turn it off.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
